{
  "manifest_version": 3,
  "name": "ETH Video Downloader Pro",
  "version": "6.1",
  "permissions": ["downloads", "tabs", "storage"],
  "host_permissions": [
    "https://video.ethz.ch/*",
    "https://dist.tobira.ethz.ch/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://video.ethz.ch/*"],
      "js": ["content.js"]
    }
  ]
}